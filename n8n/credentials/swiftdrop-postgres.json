[
  {
    "id": "swiftdrop-postgres-cred",
    "name": "SwiftDrop Postgres",
    "type": "postgres",
    "data": {
      "host": "postgres",
      "port": 5432,
      "database": "={{$env.POSTGRES_DB}}",
      "user": "={{$env.POSTGRES_USER}}",
      "password": "={{$env.POSTGRES_PASSWORD}}",
      "ssl": "disable"
    }
  }
]
