    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id, c.current_intent, c.current_state, c.context\nFROM customers cust\nLEFT JOIN conversations c ON c.customer_id = cust.id AND c.is_active = true\nWHERE cust.id = $1\nORDER BY c.created_at DESC NULLS LAST\nLIMIT 1",
        "options": { "queryReplacement": "={{ [$('Build Message Context').item.json.customer_id] }}" }
      },
      "id": "n12-load-conversation",
