    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst errors = [];\nif (!body.phone) errors.push('phone');\nif (!body.message) errors.push('message');\nif (!body.message_id) errors.push('message_id');\n\nif (errors.length > 0) {\n  return [{ json: { valid: false, missing_fields: errors } }];\n}\n\n// Normalize Nigerian phone numbers to +234XXXXXXXXXX\nlet phone = String(body.phone).replace(/[^0-9+]/g, '');\nif (phone.startsWith('0')) {\n  phone = '+234' + phone.slice(1);\n} else if (phone.startsWith('234')) {\n  phone = '+' + phone;\n} else if (!phone.startsWith('+')) {\n  phone = '+' + phone;\n}\n\nreturn [{\n  json: {\n    valid: true,\n    phone,\n    message: String(body.message).trim(),\n    message_id: String(body.message_id),\n    timestamp: body.timestamp || new Date().toISOString()\n  }\n}];"
      },
      "id": "n2-validate",
      "name": "Validate & Normalize",
      "type": "n8n-nodes-base.code",
