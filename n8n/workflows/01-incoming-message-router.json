    {
      "parameters": {
        "jsCode": "const convo = $('Load Active Conversation').item.json;\nconst ctx = $('Build Message Context').item.json;\nconst text = (ctx.message || '').toLowerCase();\n\nlet intent = convo.current_intent;\nlet state = convo.current_state;\nconst hadActiveConversation = !!state && state !== 'IDLE';\n\nif (!hadActiveConversation) {\n  if (/track|where is|status/.test(text)) intent = 'TRACK_DELIVERY';\n  else if (/reschedul|postpone|move.*deliver/.test(text)) intent = 'RESCHEDULE_DELIVERY';\n  else if (/missing|problem|hasn.?t arrived|didn.?t deliver|complain/.test(text)) intent = 'DELIVERY_PROBLEM';\n  else if (/quote|how much|cost|price/.test(text)) intent = 'DELIVERY_QUOTE';\n  else if (/send|deliver|pick\\s?up|package/.test(text)) intent = 'DELIVERY_REQUEST';\n  else intent = 'UNKNOWN';\n  state = intent === 'UNKNOWN' ? 'HUMAN_ESCALATION' : 'NEW';\n}\n\nlet context = convo.context || {};\nif (typeof context === 'string') {\n  try { context = JSON.parse(context); } catch (e) { context = {}; }\n}\n\nreturn [{\n  json: {\n    customer_id: ctx.customer_id,\n    phone: ctx.phone,\n    message: ctx.message,\n    message_id: ctx.message_id,\n    conversation_id: convo.id || null,\n    intent,\n    state,\n    current_state: state,\n    context,\n    continued_conversation: hadActiveConversation\n  }\n}];"
      },
