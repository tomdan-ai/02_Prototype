      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO messages (external_id, customer_id, conversation_id, direction, body, status)\nVALUES ($1, $2, $3, 'INBOUND', $4, 'RECEIVED')\nRETURNING id",
        "options": { "queryReplacement": "={{ [$('Build Message Context').item.json.message_id, $('Build Message Context').item.json.customer_id, $json.id || null, $('Build Message Context').item.json.message] }}" }
